Include ~/.colima/ssh_config

# Per-site host entries, created from 1Password by the install script (SITE_FILES)
Include ~/.ssh/config.d/*
# Entries for this machine only
Include ~/.ssh/config.user

# Keys come from the 1Password SSH agent when it's running. On macOS the
# install script links ~/.1password/agent.sock to the app's socket.
Match exec "test -S ~/.1password/agent.sock"
IdentityAgent ~/.1password/agent.sock

Host *
KeepAlive yes
ServerAliveInterval 120
ServerAliveCountMax 3
# For the slow host lookups disables ipv6
AddressFamily inet
#Tunnel yes

Host localhost
PubkeyAcceptedAlgorithms +ssh-rsa
HostkeyAlgorithms +ssh-rsa

# This just seems to cause more issues than speeding anything up.
#Host *.amazonaws.com
## https://developer.rackspace.com/blog/speeding-up-ssh-session-creation/
#ControlPath ~/.ssh/sockets/%h
#ControlMaster auto
#ControlPersist 600
#User ec2-user

# Also no
#Host *
## https://developer.rackspace.com/blog/speeding-up-ssh-session-creation/
## https://dammit.nl/ssh-unix-socket.html to fix the unix_listener too long for domain socket
## Keep the %n so we can find the socket if we need to remove it (stale, etc)
##ControlPath ~/.ssh/sockets/%n%C
#ControlPath ~/.ssh/sockets/%C
#ControlMaster auto
#ControlPersist 600
